# Copy to .env and fill in values. Used by python-dotenv on startup.

# --- SMTP (Gmail example) ---
# Use an App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com

# Port 465 (implicit SSL) instead of STARTTLS:
# SMTP_PORT=465
# SMTP_SSL=true

# Optional:
# SMTP_STARTTLS=true
# SMTP_TIMEOUT=30
# SMTP_DEBUG=0

# SESSION_SECRET=change-me-in-production
